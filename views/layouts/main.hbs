<!doctype html>
<html lang="uz">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} · Student Portal</title>
  <style>
    :root { --bg:#f6f7f9; --card:#fff; --line:#e3e6ea; --text:#1d2430; --muted:#6b7480; --accent:#2f5bd8; --danger:#c0392b; --ok:#1e8e5a; }
    * { box-sizing: border-box; }
    body { margin:0; font:15px/1.5 system-ui, sans-serif; background:var(--bg); color:var(--text); }
    header { background:var(--card); border-bottom:1px solid var(--line); padding:12px 16px; display:flex; gap:16px; align-items:center; flex-wrap:wrap; }
    header a { color:var(--text); text-decoration:none; font-weight:500; }
    header .brand { font-weight:700; color:var(--accent); }
    header .spacer { flex:1; }
    main { max-width:1100px; margin:24px auto; padding:0 16px; }
    h1 { font-size:22px; margin:0 0 16px; }
    .card { background:var(--card); border:1px solid var(--line); border-radius:8px; padding:16px; margin-bottom:16px; }
    .row { display:flex; gap:12px; flex-wrap:wrap; align-items:center; }
    .grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:12px; }
    .scroll { overflow-x:auto; }
    table { width:100%; border-collapse:collapse; }
    th, td { text-align:left; padding:8px 10px; border-bottom:1px solid var(--line); white-space:nowrap; }
    th { color:var(--muted); font-weight:600; font-size:13px; }
    label { display:block; font-size:13px; color:var(--muted); margin-bottom:4px; }
    input, select, textarea { width:100%; padding:8px 10px; border:1px solid var(--line); border-radius:6px; font:inherit; background:#fff; }
    textarea { resize:vertical; min-height:70px; }
    input[type=checkbox] { width:auto; }
    .btn { display:inline-block; padding:8px 14px; border:1px solid var(--accent); background:var(--accent); color:#fff; border-radius:6px; text-decoration:none; font:inherit; cursor:pointer; }
    .btn.ghost { background:transparent; color:var(--accent); }
    .btn.danger { background:transparent; border-color:var(--danger); color:var(--danger); }
    .btn.sm { padding:4px 10px; font-size:13px; }
    form.inline { display:inline; }
    .badge { display:inline-block; padding:2px 8px; border-radius:99px; font-size:12px; background:#eef1f6; }
    .badge.on { background:#e3f5ec; color:var(--ok); }
    .badge.off { background:#fbe9e7; color:var(--danger); }
    .errors { background:#fbe9e7; border:1px solid #f1c4bd; color:var(--danger); border-radius:6px; padding:10px 14px; margin-bottom:16px; }
    .errors ul { margin:0; padding-left:18px; }
    .muted { color:var(--muted); }
    .stat b { display:block; font-size:26px; }
    dl { display:grid; grid-template-columns:160px 1fr; gap:6px 12px; margin:0; }
    dt { color:var(--muted); } dd { margin:0; }
    [hidden] { display:none !important; }
    h2 { font-size:17px; margin:0 0 12px; }
    td.wrap { white-space:normal; min-width:180px; }
    .flash { border-radius:6px; padding:10px 14px; margin-bottom:16px; border:1px solid; }
    .flash.ok { background:#e3f5ec; border-color:#b7e2cb; color:var(--ok); }
    .flash.err { background:#fbe9e7; border-color:#f1c4bd; color:var(--danger); }
    /* navbat holatlari */
    .badge.s-kutilmoqda { background:#fff4dc; color:#9a6400; }
    .badge.s-tasdiqlandi { background:#e4ecff; color:var(--accent); }
    .badge.s-bajarildi { background:#e3f5ec; color:var(--ok); }
    .badge.s-kelmadi, .badge.s-bekor { background:#fbe9e7; color:var(--danger); }
    /* sana va vaqt tanlash */
    .chips { display:flex; gap:8px; flex-wrap:wrap; }
    .chip { display:inline-flex; flex-direction:column; align-items:center; min-width:84px; padding:6px 10px; border:1px solid var(--line); border-radius:8px; background:var(--card); color:var(--text); text-decoration:none; font-size:13px; line-height:1.3; }
    .chip b { font-size:15px; }
    .chip.active { border-color:var(--accent); background:#e4ecff; }
    .chip.off { color:var(--muted); background:#f0f1f3; }
    .slots { display:grid; grid-template-columns:repeat(auto-fill, minmax(86px, 1fr)); gap:8px; margin:8px 0 12px; }
    .slot input { position:absolute; opacity:0; pointer-events:none; }
    .slot span { display:block; text-align:center; padding:8px 4px; border:1px solid var(--line); border-radius:6px; cursor:pointer; background:#fff; }
    .slot input:checked + span { background:var(--accent); border-color:var(--accent); color:#fff; }
    .slot input:focus-visible + span { outline:2px solid var(--accent); outline-offset:2px; }
    .slot input:disabled + span { cursor:not-allowed; color:var(--muted); background:#f0f1f3; text-decoration:line-through; }
    .slot { position:relative; margin:0; color:var(--text); font-size:14px; }
    .xodim { display:flex; justify-content:space-between; gap:12px; align-items:center; flex-wrap:wrap; }
    .xodim .kunlar { font-size:13px; color:var(--muted); }
    .holat-form { display:flex; flex-wrap:wrap; gap:6px; align-items:center; min-width:220px; }
    .holat-form select { width:auto; padding:4px 6px; }
    .holat-form input { flex:1 1 120px; width:auto; padding:4px 6px; }
    .stats { display:grid; grid-template-columns:repeat(auto-fit, minmax(120px, 1fr)); gap:12px; margin-bottom:16px; }
    .stats .card { margin:0; padding:10px 14px; }
    .stats b { font-size:20px; }
  </style>
</head>
<body>
  {{#if me}}
  <header>
    <a class="brand" href="/">Student Portal</a>
    {{#if isStudent}}
      <a href="/navbat">Navbatlarim</a>
      <a href="/navbat/yangi">Navbatga yozilish</a>
    {{/if}}
    {{#if isStaff}}
      <a href="/users">Foydalanuvchilar</a>
      <a href="/bolimlar">Bo'limlar</a>
    {{/if}}
    {{#if qabulMenu}}
      <a href="/qabulxona">Qabulxona</a>
      <a href="/qabul">Qabul vaqtlari</a>
    {{/if}}
    <span class="spacer"></span>
    <span class="muted">{{me.familiya}} {{me.ism}} · {{rol me.role}}</span>
    <form class="inline" method="post" action="/logout"><button class="btn ghost sm">Chiqish</button></form>
  </header>
  {{/if}}
  <main>
    {{#if flash}}<div class="flash {{flash.type}}" role="status">{{flash.text}}</div>{{/if}}
    {{{body}}}
  </main>
</body>
</html>
