# Render.com -> PostgreSQL -> Connections -> "External Database URL"
# (lokal kompyuterdan ulanish uchun aynan External kerak, Internal emas)
DATABASE_URL=postgresql://USER:PASSWORD@dpg-xxxxx.frankfurt-postgres.render.com/DBNAME
# Render uchun true; lokal postgres ishlatsangiz false
DB_SSL=true
SESSION_SECRET=uzun-tasodifiy-satr-yozing
PORT=3000
# Birinchi admin (npm run migrate yaratadi)
ADMIN_LOGIN=admin
ADMIN_PAROL=admin123
